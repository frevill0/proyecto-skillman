{
  "name": "portal-pdp",
  "private": true,
  "description": "Portal PDP: app móvil y panel web para que los clientes vean su carpeta de protección de datos.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "db:push": "supabase db push",
    "ejemplo": "node scripts/generar-ejemplo.mjs",
    "importar": "node --env-file=.env scripts/importar-carpeta.mjs",
    "usuario": "node --env-file=.env scripts/crear-usuario.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "pdf-lib": "^1.17.1",
    "supabase": "^2.122.0"
  }
}
